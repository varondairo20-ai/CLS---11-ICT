# Copy this to .env and fill values (DO NOT commit credentials)
DB_HOST=localhost
DB_USER=cls_user
DB_PASSWORD=cls_pass123
DB_NAME=cls_monitor
# Optional: NEW_DB_USER/NEW_DB_PASSWORD used by init-db.js when creating a DB user
NEW_DB_USER=cls_user
NEW_DB_PASSWORD=cls_pass123
# Set FORCE_RESET=1 to drop and recreate the database when running init-db.js
FORCE_RESET=0
